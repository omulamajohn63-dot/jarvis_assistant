# Copy this file to .env and fill in what you need.
# .env is already in .gitignore, so nothing here is ever committed.
#
# Jarvis works with none of these set. Speech recognition falls back to the
# public key that ships with SpeechRecognition, the assistant name defaults to
# "Jarvis", and the browser interface binds to this computer only.

# ---------------------------------------------------------------- AI provider
# Which provider to reason with. Leave empty to run in offline mode, where the
# traditional command router handles everything.
AI_PROVIDER=
AI_MODEL=

# openai, or any service that speaks the same API (Ollama, LM Studio, vLLM).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Google Gemini. The key is sent as a header, never as part of a URL, so it does
# not end up in a log of the request line.
GOOGLE_API_KEY=

# -------------------------------------------------------------------- voice
# Optional. Speech recognition uses the public key bundled with
# SpeechRecognition when this is unset, which Google may revoke at any time.
GOOGLE_SPEECH_API_KEY=

JARVIS_NAME=Jarvis
VOICE_ENABLED=true
VOICE_INDEX=1
VOICE_RATE=150
VOICE_VOLUME=1.0

# ------------------------------------------------------------------- memory
MEMORY_ENABLED=true

# ------------------------------------------------------------------- safety
# Ask before doing anything that changes Windows. Leaving this on is the point:
# shutdown and restart refuse to happen without an answer that matches the
# question that was asked.
CONFIRM_DANGEROUS_ACTIONS=true

# ------------------------------------------------------------------ browser
# 127.0.0.1 keeps the interface on this computer and off the network.
HOST=127.0.0.1
PORT=8765